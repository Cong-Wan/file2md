# ============================================================
# PDF 解析 API (MinerU)
# ============================================================
PDF_API_URL=http://your-pdf-api-host:9091
PDF_API_MODEL=mineru2.5

# ============================================================
# 翻译 API (Anthropic-compatible)
# ============================================================
TRANSLATE_API_URL=https://your-translate-api-host/v1/chat/completions
TRANSLATE_API_KEY=your-translate-api-key
TRANSLATE_API_MODEL=your-translate-model
